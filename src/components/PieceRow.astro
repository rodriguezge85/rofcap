---
import { seriesLabel } from '../content/obsidian';
import { metaLine, type Piece } from '../lib/obsidian';
interface Props { piece: Piece }
const { piece } = Astro.props;
const meta = metaLine({ date: piece.date, minutes: piece.minutes });
---
<article class="piece" data-series={piece.series}>
  <p class="kicker">{seriesLabel(piece.series)}</p>
  <h3>{piece.href ? <a href={piece.href}>{piece.title}</a> : piece.title}</h3>
  <p>{piece.standfirst}</p>
  {meta && <p class="meta">{meta}</p>}
</article>
