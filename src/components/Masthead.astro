---
import { site } from '../content/site';
---
<header class="masthead">
  <div class="wrap">
    <a href="/" aria-label={`${site.legalName}, home`}>
      <img src="/rofcap-mark-on-dark.svg" alt="" width="48" height="48" />
      <span>
        <span class="masthead-word">{site.shortName}</span>
        <span class="masthead-full">{site.legalName}</span>
      </span>
    </a>
  </div>
</header>
