---
import { site } from '../content/site';
---
<footer>
  <div class="wrap">
    <img src="/rofcap-mark-96.png" alt="" width="38" height="38" />
    <div class="footer-text">
      <p><strong>{site.legalName}</strong></p>
      <p>{site.address.lines.join(', ')}</p>
      <p>{site.notice} · <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></p>
    </div>
  </div>
</footer>
