---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';
import Framework from '../components/Framework.astro';
import PieceRow from '../components/PieceRow.astro';
import { home } from '../content/site';
import { obsidian } from '../content/obsidian';
import { getPieces } from '../lib/obsidian';

const recent = (await getPieces()).slice(0, 3);
---
<BaseLayout header="overlay">
  <div class="hero">
    <Photo eager position="center 30%" opacity={0.6} />
    <div class="wrap split hero-copy">
      <div class="hero-text content-start">
        <p class="eyebrow">{home.eyebrow}</p>
        <h1>{home.title}</h1>
        <p class="hero-sub">{home.tagline}</p>
      </div>
    </div>
  </div>

  <Section label="Who we are" id="who">
    <p class="lead">{home.lead}</p>
    <p>{home.body}</p>
    <ul class="cols three ruled">
      {home.services.map((s) => (
        <li><h3>{s.title}</h3><p>{s.text}</p></li>
      ))}
    </ul>
  </Section>

  <Section label="The Ring of Fire" id="ring" tone="white">
    <p class="lead">{home.ring.lead}</p>
    <dl class="stats">
      {home.ring.stats.map((s) => (
        <div><dt>{s.label}</dt><dd class="num stat">{s.value}</dd></div>
      ))}
    </dl>
    <p>{home.ring.body}</p>
  </Section>

  <Framework id="framework" variant="home" />

  <section class="band dark" id="obsidian" aria-labelledby="obsidian-label">
    <div class="wrap split">
      <div class="label-col">
        <h2 class="wordmark" id="obsidian-label">OBSIDIAN</h2>
        <p class="on-dark-small">{obsidian.byline}</p>
        <p class="on-dark-lead">{obsidian.tagline}</p>
        <a class="pill" href="/obsidian/">All pieces</a>
      </div>
      <div class="content">
        {recent.map((piece) => <PieceRow piece={piece} />)}
      </div>
    </div>
  </section>
</BaseLayout>
