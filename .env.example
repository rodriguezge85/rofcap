# Copy to .env for local development. Never commit .env.
# Phase 1 needs no environment variables. The values below apply from Phase 3 (inquiry form).

# Public site URL (used for canonical, sitemap, Open Graph)
SITE_URL=http://localhost:4321

# Inquiry form kill switch (true/false)
INQUIRY_ENABLED=false

# Bot protection (Cloudflare Turnstile): site key is public, secret is not
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Transactional email provider
EMAIL_API_KEY=
INQUIRY_TO=
INQUIRY_FROM=
