{
  "name": "rofcap-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro build",
    "preview": "astro preview",
    "check": "npm run tokens && npm run check:contrast && astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "og": "python3 scripts/og-card.py"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "astro": "^7.4.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3"
  }
}
